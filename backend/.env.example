# Local development only. Copy to .env and supply your own values.
# Production: set APP_ENV=production in the process environment; dotenv is ignored.
APP_ENV=development
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_CONNECT_TIMEOUT_SECONDS=5
READINESS_DB_TIMEOUT_SECONDS=2
READINESS_TIMEOUT_SECONDS=3
MYSQL_USER=<local-database-user>
MYSQL_PASSWORD=<local-database-password>
MYSQL_DATABASE=lankapex_db
JWT_SECRET_KEY=<private-signing-secret>
ACCESS_TOKEN_EXPIRE_MINUTES=60
REMINDER_COOLDOWN_SECONDS=86400
APP_DEBUG=false
LOG_LEVEL=INFO
RATE_LIMIT_MODE=local
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN=10
RATE_LIMIT_LOGIN_IP=40
RATE_LIMIT_REGISTRATION=10
RATE_LIMIT_MUTATION=60
RATE_LIMIT_EXPORT=5
RATE_LIMIT_AI_GENERATION=5
RATE_LIMIT_MAX_KEYS=4096
MAX_REQUEST_BODY_BYTES=262144
MAX_INTERACTIVE_CUSTOMERS=1000
MAX_READ_LEDGER_ENTRIES=5000
# Optional backend-only AI generation. Never expose GROQ_API_KEY through VITE_ variables.
AI_ENABLED=false
# GROQ_API_KEY=<backend-only-secret>
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=10
GROQ_MAX_OUTPUT_TOKENS=256
# Production requires RATE_LIMIT_MODE=external and verified shared/edge enforcement.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOWED_HOSTS=localhost,127.0.0.1
# MYSQL_SSL_CA=<existing-provider-ca-file-path>
# Testing: explicitly set APP_ENV=testing and MYSQL_DATABASE=lankapex_test_db.
# Production must explicitly supply MYSQL_*, JWT_SECRET_KEY, HTTPS origins and hosts.
# Never put backend secrets into VITE_ variables.
