-- 1. Authorized DBA: establish existence and object inventory independently.
SELECT VERSION(), @@GLOBAL.partial_revokes, @@SESSION.sql_mode,
       @@SESSION.time_zone, @@GLOBAL.lower_case_table_names;
SELECT SCHEMA_NAME, DEFAULT_CHARACTER_SET_NAME, DEFAULT_COLLATION_NAME
FROM information_schema.SCHEMATA
WHERE SCHEMA_NAME = 'lankapex_migration_verify_20261107';
SELECT TABLE_NAME, TABLE_TYPE
FROM information_schema.TABLES
WHERE TABLE_SCHEMA = 'lankapex_migration_verify_20261107';
SELECT ROUTINE_NAME, ROUTINE_TYPE
FROM information_schema.ROUTINES
WHERE ROUTINE_SCHEMA = 'lankapex_migration_verify_20261107';
SELECT EVENT_NAME
FROM information_schema.EVENTS
WHERE EVENT_SCHEMA = 'lankapex_migration_verify_20261107';

